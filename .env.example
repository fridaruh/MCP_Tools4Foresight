# URL base de la API pública de tools4foresight.
# Default: https://tools4foresight.com/api/public/v1
# Obligatoria: no
T4F_API_BASE_URL=https://tools4foresight.com/api/public/v1

# Clave de API para acceder a la API pública de tools4foresight.
# Obligatoria: sí
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
T4F_API_KEY=

# Tiempo máximo en ms para cada petición HTTP a la API.
# Default: 15000
# Obligatoria: no
T4F_TIMEOUT_MS=15000

# Número de reintentos en caso de error 429, 5xx o fallo de conexión.
# Default: 2
# Obligatoria: no
T4F_RETRIES=2

# Tiempo de vida en ms del caché de respuestas HTTP. 0 = desactiva.
# Default: 60000
# Obligatoria: no
T4F_CACHE_TTL_MS=60000

# Nivel de logging: "silent" (solo errores), "error", "debug".
# Default: "error"
# Obligatoria: no
T4F_LOG_LEVEL=error

# Token de acceso para el endpoint HTTP remoto (api/mcp.ts en Vercel).
# Si falta, devuelve 503. Debe ser diferente a T4F_API_KEY.
# Obligatoria: sí (si usas HTTP remoto)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_ACCESS_TOKEN=

# Puerto para el servidor HTTP local (src/http.ts, solo para desarrollo/self-host).
# Default: 3001
# Obligatoria: no
MCP_PORT=3001
